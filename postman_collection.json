{
  "info": {
    "name": "WhatsApp API (Baileys)",
    "_postman_id": "whatsapp-api-baileys-collection",
    "description": "Postman collection untuk WhatsApp API berbasis Baileys. Endpoint sensitif butuh Bearer JWT (variabel {{token}}).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
        "description": "Health check"
      }
    },
    {
      "name": "GET /status",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/status", "host": ["{{baseUrl}}"], "path": ["status"] },
        "description": "Cek apakah WhatsApp client sudah siap"
      }
    },
    {
      "name": "GET /qr",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/qr", "host": ["{{baseUrl}}"], "path": ["qr"] },
        "description": "Ambil QR (data URL) untuk discan jika belum terautentikasi"
      }
    },
    {
      "name": "POST /send",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"number\": \"628123456789\",\n  \"message\": \"Halo dari API\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/send", "host": ["{{baseUrl}}"], "path": ["send"] },
        "description": "Kirim pesan teks (format internasional tanpa + atau diawali 0)"
      }
    },
    {
      "name": "POST /send-file (multipart)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": "" },
            { "key": "number", "value": "089530518554", "type": "text" },
            { "key": "caption", "value": "Dokumen PDF", "type": "text" }
          ]
        },
        "url": { "raw": "{{baseUrl}}/send-file", "host": ["{{baseUrl}}"], "path": ["send-file"] },
        "description": "Kirim file via multipart form upload (field 'file')"
      }
    },
    {
      "name": "POST /send-file (JSON fileUrl)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"number\": \"628123456789\",\n  \"fileUrl\": \"https://example.com/doc.pdf\",\n  \"caption\": \"Dokumen\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/send-file", "host": ["{{baseUrl}}"], "path": ["send-file"] },
        "description": "Kirim file via URL"
      }
    },
    {
      "name": "POST /session/reset",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/session/reset", "host": ["{{baseUrl}}"], "path": ["session", "reset"] },
        "description": "Paksa sesi baru: logout + hapus sesi lama, lalu generate QR baru. Butuh JWT login app."
      }
    },
    {
      "name": "POST /logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/logout", "host": ["{{baseUrl}}"], "path": ["logout"] },
        "description": "Logout dari WhatsApp (butuh JWT)"
      }
    },
    {
      "name": "POST /client/restart",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/client/restart", "host": ["{{baseUrl}}"], "path": ["client", "restart"] },
        "description": "Logout lalu inisialisasi ulang socket (butuh JWT)"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "<JWT_LOGIN_APP>", "type": "string" }
  ]
}