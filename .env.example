# WhatsApp API (Baileys) - contoh konfigurasi
# Copy ke .env lalu sesuaikan. JANGAN commit .env.

PORT=5000
NODE_ENV=production

# CORS: origin frontend yang diizinkan (pisahkan koma). "*" untuk semua.
ALLOWED_ORIGINS=https://www.zeatextile.cloud

# Path auth state Baileys.
# Di Docker di-set otomatis via docker-compose ke /app/auth (volume whatsapp_auth).
# Untuk run lokal (npm start), biarkan kosong agar default ./auth dipakai.
# BAILEYS_AUTH_PATH=/app/auth

# Level log: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# Cetak QR ASCII ke log container saat generate
BAILEYS_LOG_QR=true

# --- Proteksi endpoint sensitif (/session/reset, /logout, /client/restart) ---
# WAJIB: samakan PERSIS dengan JWT_SECRET di Api/.env (untuk verifikasi token login app).
JWT_SECRET="ganti-sama-persis-dengan-Api-env-JWT_SECRET"
# Role yang boleh men-trigger aksi sensitif. Kosongkan untuk semua user login.
RESET_ALLOWED_ROLES=SUPER_ADMIN,ADMIN_TOKO
